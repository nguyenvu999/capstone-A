{
  "version": 2,
  "rewrites": [
    {
      "source": "/.well-known/microsoft-identity-association",
      "destination": "/microsoft-identity-association.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/microsoft-identity-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}